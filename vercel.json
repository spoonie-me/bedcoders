{
  "buildCommand": "npm run build && cd backend && npx prisma generate",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "backend/src/**"
    }
  },
  "redirects": [
    { "source": "/advisors", "destination": "/", "permanent": true },
    { "source": "/advisors/:path*", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
