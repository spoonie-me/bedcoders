{
  "buildCommand": "npm run build && cd backend && npx prisma generate",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "backend/src/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://analytics.umami.is; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https://api.bedcoders.com https://*.posthog.com https://*.stripe.com https://analytics.umami.is https://www.google-analytics.com; frame-src 'self' https://*.stripe.com https://js.stripe.com; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api" },

    { "src": "/advisors", "status": 308, "headers": { "Location": "/" } },
    { "src": "/advisors/(.*)", "status": 308, "headers": { "Location": "/" } },

    { "handle": "filesystem" },

    { "src": "/dashboard", "dest": "/index.html" },
    { "src": "/settings", "dest": "/index.html" },
    { "src": "/signup-success", "dest": "/index.html" },
    { "src": "/forgot-password", "dest": "/index.html" },
    { "src": "/reset-password", "dest": "/index.html" },
    { "src": "/welcome-member", "dest": "/index.html" },
    { "src": "/welcome-specialist", "dest": "/index.html" },
    { "src": "/welcome-architect", "dest": "/index.html" },
    { "src": "/lesson/(.*)", "dest": "/index.html" },
    { "src": "/track/(.*)", "dest": "/index.html" },
    { "src": "/module/(.*)", "dest": "/index.html" },
    { "src": "/assessment/(.*)", "dest": "/index.html" },
    { "src": "/exam/(.*)", "dest": "/index.html" },
    { "src": "/certificate/(.*)", "dest": "/index.html" },
    { "src": "/leaderboard/(.*)", "dest": "/index.html" },
    { "src": "/go/(.*)", "dest": "/index.html" },

    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
