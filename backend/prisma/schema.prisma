generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["bedcoders"]
}

// ──────────────────────────────────────────
// USERS & AUTH
// ──────────────────────────────────────────

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  name                   String?
  passwordHash           String
  emailVerified          Boolean   @default(false)
  emailVerificationToken String?
  passwordResetToken     String?
  passwordResetAt        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  lastLoginAt            DateTime?

  // Preferences
  darkMode Boolean @default(true)
  language String  @default("en")
  timeZone String  @default("UTC")

  // GDPR
  gdprConsentedAt    DateTime?
  gdprConsentVersion String?
  privacyConsentedAt DateTime?
  analyticsOptIn     Boolean   @default(false)
  marketingOptIn     Boolean   @default(false)

  // Accessibility
  reduceMotion Boolean @default(false)
  highContrast Boolean @default(false)
  fontSize     String  @default("medium")

  // Data subject rights
  dataExportRequestedAt DateTime?
  dataExportCompletedAt DateTime?
  deletionRequestedAt   DateTime?
  deletionScheduledAt   DateTime?

  // Stripe
  stripeCustomerId     String?
  stripeSubscriptionId String?

  // Leaderboard
  leaderboardOptIn Boolean @default(false)

  // Relations
  subscription       Subscription?
  profile            UserProfile?
  progress           LessonProgress[]
  gamification       Gamification?
  submissions        Submission[]
  auditLog           AuditLog[]
  activityLog        ActivityLog[]
  domainMastery      DomainMastery[]
  assessmentAttempts AssessmentAttempt[]
  examAttempts       ExamAttempt[]
  badges             UserBadge[]
  certificates       Certificate[]
  challenges         UserChallenge[]
  leaderboard        LeaderboardEntry[]
  talentProfile      TalentProfile?
  @@schema("bedcoders")
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  bio         String?
  avatar      String?
  country     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@schema("bedcoders")
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               String // free, pro_monthly, pro_annual, team_seat
  stripeId           String?
  stripeSessionId    String?   @unique // Stripe checkout session ID for idempotency
  status             String // active, cancelled, past_due, trialing
  tracksUnlocked     String   @default("[]") // JSON array of track IDs
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  @@schema("bedcoders")
}

// ──────────────────────────────────────────
// COMPETENCY FRAMEWORK
// ──────────────────────────────────────────

model CompetencyDomain {
  id          String   @id @default(cuid())
  trackId     String // fundamentals, ai, tools, advanced
  name        String
  description String
  order       Int
  createdAt   DateTime @default(now())

  modules Module[]
  mastery DomainMastery[]

  @@unique([trackId, order])
  @@schema("bedcoders")
}

model Module {
  id          String           @id @default(cuid())
  domainId    String
  domain      CompetencyDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  title       String
  description String
  tier        String // foundation, application, mastery
  bloomLevel  String // remember, understand, apply, analyze, evaluate, create
  order       Int
  isPublished Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lessons    Lesson[]
  assessment ModuleAssessment?
  @@schema("bedcoders")
}

model DomainMastery {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId   String
  domain     CompetencyDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  score      Float            @default(0) // weighted avg 0-100
  stars      Int              @default(0) // 0-5
  isMastered Boolean          @default(false)
  updatedAt  DateTime         @updatedAt

  @@unique([userId, domainId])
  @@schema("bedcoders")
}

// ──────────────────────────────────────────
// CURRICULUM & LESSONS
// ──────────────────────────────────────────

model Lesson {
  id                 String    @id @default(cuid())
  moduleId           String
  module             Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title              String
  description        String
  learningObjectives String @default("[]") // JSON: [{text, bloomLevel}]
  contentSections    String @default("[]") // JSON: [{type, body}]
  duration           Int // minutes
  difficulty         String
  order              Int
  isPublished        Boolean   @default(false)
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  exercises Exercise[]
  progress  LessonProgress[]
  @@schema("bedcoders")
}

// ExerciseType values: MULTIPLE_CHOICE, OPEN_ENDED, MATCHING, SEQUENCING,
// FILL_IN_BLANK, CASE_STUDY, DIAGRAM_LABEL, CODE_QUERY, TRUE_FALSE_JUSTIFY, CATEGORIZATION

model Exercise {
  id               String            @id @default(cuid())
  lessonId         String?
  lesson           Lesson?           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  assessmentId     String?
  assessment       ModuleAssessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  ref              String            @unique // human-readable ID e.g. HI-EHR-001
  prompt           String
  type             String // ExerciseType enum as string
  config           String // JSON — type-specific config
  hints            String   @default("[]") // JSON array
  explanation      String? // shown after submission — the "why"
  difficulty       String // easy, medium, hard
  bloomLevel       String // remember, understand, apply, analyze, evaluate, create
  domainId         String? // for exercise bank queries / exam stratification
  timeEstimate     Int               @default(60) // seconds
  xpReward         Int               @default(10)
  isKnowledgeCheck Boolean           @default(false) // true = inline check, false = graded
  order            Int
  version          Int               @default(1)
  isActive         Boolean           @default(true)
  tags             String   @default("[]") // JSON array
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  submissions Submission[]

  @@index([domainId, type])
  @@index([lessonId, order])
  @@schema("bedcoders")
}

model Submission {
  id            String   @id @default(cuid())
  exerciseId    String
  exercise      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answer        String // JSON: structured answer (varies by exercise type)
  feedback      String? // AI-generated feedback
  score         Int? // 0-100
  isCorrect     Boolean?
  attemptNumber Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, exerciseId])
  @@schema("bedcoders")
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status      String // not-started, in-progress, completed
  progress    Int       @default(0) // percentage
  xpEarned    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@schema("bedcoders")
}

// ──────────────────────────────────────────
// ASSESSMENTS & EXAMS
// ──────────────────────────────────────────

model ModuleAssessment {
  id            String   @id @default(cuid())
  moduleId      String   @unique
  module        Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title         String
  description   String
  timeLimit     Int? // minutes, null = untimed
  passScore     Int      @default(80)
  randomize     Boolean  @default(true)
  questionCount Int      @default(10) // draw this many if randomized
  createdAt     DateTime @default(now())

  exercises Exercise[]
  attempts  AssessmentAttempt[]
  @@schema("bedcoders")
}

model AssessmentAttempt {
  id           String           @id @default(cuid())
  assessmentId String
  assessment   ModuleAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  score        Float
  passed       Boolean
  startedAt    DateTime         @default(now())
  completedAt  DateTime?
  answers      String @default("[]") // JSON: [{exerciseId, answer, score, isCorrect}]

  @@index([userId, assessmentId])
  @@schema("bedcoders")
}

model TrackExam {
  id            String   @id @default(cuid())
  trackId       String   @unique // fundamentals, ai, tools, advanced
  title         String
  description   String
  timeLimit     Int // minutes
  passScore     Int      @default(75)
  questionCount Int      @default(50)
  createdAt     DateTime @default(now())

  attempts ExamAttempt[]
  @@schema("bedcoders")
}

model ExamAttempt {
  id            String    @id @default(cuid())
  examId        String
  exam          TrackExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  score         Float
  passed        Boolean
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  answers       Json // [{exerciseId, answer, score, isCorrect}]
  certificateId String?

  @@index([userId, examId])
  @@schema("bedcoders")
}

// ──────────────────────────────────────────
// GAMIFICATION
// ──────────────────────────────────────────

model Gamification {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp        Int       @default(0)
  level          Int       @default(1)
  currentStreak  Int       @default(0)
  bestStreak     Int       @default(0)
  lastActiveDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@schema("bedcoders")
}

model Badge {
  id          String   @id @default(cuid())
  key         String   @unique // first_lesson, ehr_master, streak_7, etc.
  name        String
  description String
  icon        String // emoji or SVG filename
  tier        String // bronze, silver, gold, crystal
  category    String // milestone, streak, mastery, challenge
  criteria    String @default("{}") // JSON: machine-readable unlock condition
  createdAt   DateTime @default(now())

  users UserBadge[]
  @@schema("bedcoders")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@schema("bedcoders")
}

model Challenge {
  id          String   @id @default(cuid())
  type        String // daily, weekly
  title       String
  description String
  criteria    String @default("{}") // JSON: {action, count, timeframe}
  xpReward    Int
  activeFrom  DateTime
  activeUntil DateTime
  createdAt   DateTime @default(now())

  participants UserChallenge[]
  @@schema("bedcoders")
}

model UserChallenge {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, challengeId])
  @@schema("bedcoders")
}

model Certificate {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId    String
  examScore  Float
  issuedAt   DateTime @default(now())
  pdfUrl     String?
  verifyCode String   @unique // public verification code

  @@unique([userId, trackId])
  @@schema("bedcoders")
}

model LeaderboardEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  totalXp   Int
  rank      Int?
  updatedAt DateTime @updatedAt

  @@unique([userId, trackId])
  @@index([trackId, totalXp])
  @@schema("bedcoders")
}

// ──────────────────────────────────────────
// COMPLIANCE & AUDIT
// ──────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  resource   String?
  resourceId String?
  changes    String?
  ipAddress  String?
  userAgent  String?
  status     String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([userId, action])
  @@index([createdAt])
  @@schema("bedcoders")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  lessonId   String?
  exerciseId String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@schema("bedcoders")
}

model ConsentLog {
  id             String   @id @default(cuid())
  userId         String?
  consentType    String
  consentStatus  Boolean
  consentVersion String   @default("1.0")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([consentType, createdAt])
  @@schema("bedcoders")
}

model DataDeletionRequest {
  id          String    @id @default(cuid())
  userId      String    @unique
  requestedAt DateTime  @default(now())
  scheduledAt DateTime
  completedAt DateTime?
  status      String
  reason      String?
  notes       String?

  @@index([status, scheduledAt])
  @@schema("bedcoders")
}

model DataExportRequest {
  id          String    @id @default(cuid())
  userId      String
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  exportUrl   String?
  expiresAt   DateTime?
  status      String
  format      String    @default("json")

  @@index([userId, status])
  @@schema("bedcoders")
}

// ──────────────────────────────────────────
// BLOG & PODCAST
// ──────────────────────────────────────────

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String   // Markdown
  authorEmail String   @default("hello@bedcoders.com")

  // SEO
  metaTitle       String?
  metaDescription String?
  keywords        String?
  featuredImage   String?

  // Publishing
  status       String    @default("draft") // draft, scheduled, published
  publishedAt  DateTime?
  scheduledFor DateTime?
  viewCount    Int       @default(0)

  // Podcast
  audioUrl         String?
  podcastPublished Boolean   @default(false)
  podcastDuration  Int?
  podcastEpNum     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@schema("bedcoders")
}

// ──────────────────────────────────────────
// EMAIL AUTOMATION
// ──────────────────────────────────────────

model EmailSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  source      String   @default("general") // spooniversity, bedcoders, regul8, roi
  status      String   @default("active")  // active, unsubscribed
  sequenceId  String?  // which sequence they're in
  sequenceStep Int     @default(0)         // which email they're on
  nextSendAt  DateTime?                    // when to send next email
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?
  tags        String   @default("[]")      // JSON array of tags
  metadata    String   @default("{}")      // JSON for extra data

  sentEmails  EmailSent[]

  @@index([status, nextSendAt])
  @@index([source])
  @@index([sequenceId, sequenceStep])
  @@schema("bedcoders")
}

model EmailSent {
  id           String   @id @default(cuid())
  subscriberId String
  subscriber   EmailSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  sequenceId   String
  stepNumber   Int
  subject      String
  sentAt       DateTime @default(now())
  resendId     String?  // Resend message ID for tracking

  @@index([subscriberId])
  @@index([sentAt])
  @@schema("bedcoders")
}

// ──────────────────────────────────────────
// HIRING — TALENT ↔ EMPLOYERS
//
// Design rules, enforced here and in backend/src/lib/talentVisibility.ts:
//
//  1. Nothing about a learner reaches an employer unless the learner turned
//     it on. Every visibility column below defaults to `false`, and
//     `isDiscoverable` is the master switch that gates all of them.
//  2. There is deliberately NO health, diagnosis, disability or
//     accommodation column on TalentProfile. Soft Reset School knows why its
//     learners need flexible work; employers do not need to. What employers
//     see is the *work shape* a learner wants (async, part-time, flexible
//     hours), never the reason behind it. Do not add such a column later —
//     if a learner wants to disclose, that is theirs to write in `summary`.
//  3. Contact details (real name, email) are never selected into an employer
//     response by the directory. They are released only after the learner
//     accepts an IntroRequest.
//
// See docs/HIRING_DATA_POLICY.md.
// ──────────────────────────────────────────

model TalentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stable pseudonymous identifier — what employers see instead of a name
  // until the learner opts into showing their real one.
  publicHandle String @unique

  // Master switch. Off until the learner explicitly turns it on.
  isDiscoverable Boolean   @default(false)
  discoverableAt DateTime?

  headline String? // e.g. "Agent tooling + eval harnesses"
  summary  String?
  pronouns String?

  // Work shape (NOT health data — see note above)
  openToWork      Boolean   @default(false)
  hoursPerWeekMin Int?
  hoursPerWeekMax Int?
  wantsRemote     Boolean   @default(true)
  wantsAsync      Boolean   @default(false)
  wantsPartTime   Boolean   @default(false)
  wantsFlexHours  Boolean   @default(false)
  wantsContract   Boolean   @default(false)
  earliestStart   DateTime?

  // Per-field visibility — every one opt-in
  showRealName     Boolean @default(false)
  showCountry      Boolean @default(false)
  showTimeZone     Boolean @default(false)
  showPortfolio    Boolean @default(false)
  showCertificates Boolean @default(false)
  showMastery      Boolean @default(false)
  showLinks        Boolean @default(false)

  links String @default("[]") // JSON: [{label, url}]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects      PortfolioProject[]
  introRequests IntroRequest[]
  applications  JobApplication[]

  @@index([isDiscoverable, openToWork])
  @@schema("bedcoders")
}

model PortfolioProject {
  id              String        @id @default(cuid())
  talentProfileId String
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  title       String
  description String

  // Provenance is the whole point of the portfolio: `curriculum` items are
  // graded coursework the platform can vouch for, `self` items are
  // learner-supplied and labelled as such to employers.
  source   String  @default("self") // curriculum, self
  moduleId String?

  repoUrl String?
  liveUrl String?
  skills  String  @default("[]") // JSON array of skill keys

  isVisible Boolean @default(false)
  order     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([talentProfileId, order])
  @@schema("bedcoders")
}

model Company {
  id   String @id @default(cuid())
  slug String @unique
  name String

  websiteUrl  String?
  logoUrl     String?
  description String?
  size        String? // 1-10, 11-50, 51-200, 201-1000, 1000+
  location    String?

  // Commitments a company makes to this talent pool. Shown on every job and
  // every intro request so learners can judge before engaging.
  remotePolicy            String? // remote_first, hybrid, onsite
  asyncFriendly           Boolean @default(false)
  flexibleHours           Boolean @default(false)
  partTimeOpen            Boolean @default(false)
  accommodationsStatement String?

  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  members       EmployerAccount[]
  jobs          JobPosting[]
  introRequests IntroRequest[]

  @@schema("bedcoders")
}

model EmployerAccount {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  jobTitle     String?

  emailVerified          Boolean @default(false)
  emailVerificationToken String?

  role      String   @default("owner") // owner, member
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  introRequests IntroRequest[]

  @@index([companyId])
  @@schema("bedcoders")
}

model JobPosting {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title       String
  description String
  location    String?

  isRemote         Boolean @default(true)
  isAsyncFriendly  Boolean @default(false)
  hasFlexibleHours Boolean @default(false)
  employmentType   String  @default("full_time") // full_time, part_time, contract, internship
  hoursPerWeekMin  Int?
  hoursPerWeekMax  Int?

  // Pay range is required to publish (enforced in routes/jobs.ts). A board
  // aimed at people with weak negotiating positions does not run blind
  // salary listings.
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String @default("EUR")
  salaryPeriod   String @default("year") // year, month, hour

  skills String @default("[]") // JSON array of skill keys

  status      String    @default("draft") // draft, published, closed
  publishedAt DateTime?
  closesAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications  JobApplication[]
  introRequests IntroRequest[]

  @@index([status, publishedAt])
  @@index([companyId, status])
  @@schema("bedcoders")
}

model IntroRequest {
  id String @id @default(cuid())

  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employerAccountId String
  employerAccount   EmployerAccount @relation(fields: [employerAccountId], references: [id], onDelete: Cascade)

  talentProfileId String
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  jobPostingId String?
  jobPosting   JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)

  message String

  // pending → accepted | declined | withdrawn | expired.
  // Contact details are released to the employer only on `accepted`, and
  // `contactReleasedAt` records when that happened.
  status            String    @default("pending")
  respondedAt       DateTime?
  contactReleasedAt DateTime?

  // Requests expire so a learner who is having a bad month is never left
  // with a queue that reads as debt. Expired ≠ declined.
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([talentProfileId, status])
  @@index([companyId, status])
  @@schema("bedcoders")
}

model JobApplication {
  id           String     @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  talentProfileId String
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  coverNote String?

  // submitted → viewed → in_review → interview → offer → hired
  //                                            └→ not_selected | withdrawn
  status          String   @default("submitted")
  statusUpdatedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobPostingId, talentProfileId])
  @@index([talentProfileId, status])
  @@schema("bedcoders")
}

// Aggregate-only demand signal, so curriculum planning can see which skills
// employers actually search and hire for. Deliberately carries no talent id,
// no employer id and no timestamps beyond a coarse counter — it answers
// "is anyone asking for evals?" and nothing about any individual.
model SkillDemandSignal {
  id       String @id @default(cuid())
  skillKey String @unique

  searchCount Int @default(0) // times it appeared in a directory filter
  postedCount Int @default(0) // times it appeared on a published job

  updatedAt DateTime @updatedAt

  @@index([searchCount])
  @@schema("bedcoders")
}
